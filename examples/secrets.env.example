# Copy outside the checkout, chmod 600, and replace placeholders before use.
# Give each service its own file and only the variables it needs.
# Docker --env-file uses literal KEY=value lines, not shell commands or exports.

# Renovate: use a token scoped to the repositories it should maintain.
RENOVATE_PLATFORM=github
RENOVATE_TOKEN=REPLACE_WITH_SCOPED_TOKEN
RENOVATE_REPOSITORIES=YOUR_ORGANIZATION/YOUR_REPOSITORY
RENOVATE_AUTODISCOVER=false

# For your own maintenance image, use its documented variable names instead.
# GITHUB_TOKEN=REPLACE_WITH_SEPARATE_SCOPED_TOKEN
